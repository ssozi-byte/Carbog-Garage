# ---- App ----
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ---- CORS (explicit allow-list; never "*" in production, Spec §34) ----
FRONTEND_URL=http://localhost:5173
# Comma-separated extra allowed origins (optional)
EXTRA_CORS_ORIGINS=

# ---- Database (Phase 2) ----
# Host port 5433 (compose remap) — 5432 may be used by other local projects
DATABASE_URL=postgresql://motora:motora@localhost:5433/motora?schema=public

# ---- Redis / queues (Phase 8) ----
REDIS_URL=redis://localhost:6380

# ---- Auth secrets (generate with: openssl rand -hex 48) ----
# Placeholders below are DEV-ONLY. Replace before any shared/staging deploy.
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-32chars-min
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-32chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Phase 3 auth — encrypts TOTP secrets at rest (AES-256-GCM).
# Required (≥32 chars) before MFA enrollment/logins work.
MFA_ENCRYPTION_KEY=dev-only-mfa-encryption-key-0123456789abcdef-CHANGE-ME

# Invite code so a seeded staff account can claim credentials via
# POST /auth/register { staffInviteCode }. Leave empty to disable claiming.
STAFF_INVITE_CODE=dev-only-staff-invite-change-me

# ---- M-Pesa Daraja (Phase 7 — sandbox only in dev, Spec §14/§15) ----
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=

# ---- Notifications (Phase 8) ----
SMS_API_KEY=
WHATSAPP_API_KEY=

# ---- Object storage (Phase 9 — MinIO in dev) ----
S3_ENDPOINT=http://localhost:9002
S3_ACCESS_KEY=motora
S3_SECRET_KEY=motora-dev-secret
S3_BUCKET=motora-media
