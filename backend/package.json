    "@nestjs/core": "^10.4.4",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/terminus": "^10.2.3",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/client": "^6.19.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "helmet": "^7.1.0",
    "pino": "^9.4.0",
    "prisma": "^6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
