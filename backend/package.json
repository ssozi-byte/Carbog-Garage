    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "version": "0.1.0",
  "private": true,
  "description": "MOTORA Garage platform backend (NestJS modular monolith)",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
